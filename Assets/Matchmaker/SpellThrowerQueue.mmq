{
  "$schema": "https://ugs-config-schemas.unity3d.com/v1/matchmaker/matchmaker-queue.schema.json",
  "name": "spellthrower-1v1",
  "enabled": true,
  "maxPlayersPerTicket": 1,
  "defaultPool": {
    "name": "default-pool",
    "enabled": true,
    "timeoutSeconds": 90,
    "matchHosting": {
      "type": "MatchId"
    },
    "matchLogic": {
      "name": "Rules",
      "backfillEnabled": false,
      "matchDefinition": {
        "teams": [
          {
            "name": "Player",
            "teamCount": { "min": 2, "max": 2 },
            "playerCount": { "min": 1, "max": 1 }
          }
        ],
        "matchRules": []
      }
    },
    "variants": []
  },
  "filteredPools": []
}
