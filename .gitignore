# ---- Unity ----
.utmp/
[Ll]ibrary/
[Tt]emp/
[Oo]bj/
[Bb]uild/
[Bb]uilds/
[Ll]ogs/
[Uu]ser[Ss]ettings/
*.log

# Blender backup files are not Unity assets
*.blend1

# Memory captures and recordings can be large or contain sensitive data
/[Mm]emoryCaptures/
/[Rr]ecordings/

# .meta files must follow their asset — never ignore them under Assets/
!/[Aa]ssets/**/*.meta
*.blend1.meta

# Autogenerated VS/Rider/IDE files
.vs/
.idea/
.vscode/
.gradle/
ExportedObj/
.consulo/
*.csproj
*.unityproj
*.sln
*.slnx
*.suo
*.user
*.userprefs
*.pidb
*.booproj
*.svd
*.pdb
*.mdb
*.opendb
*.VC.db
*.tmp
*.DotSettings.user

# Unity3D generated meta files
*.pidb.meta
*.pdb.meta
*.mdb.meta

# Unity crash reports
sysinfo.txt
mono_crash.*

# Builds / packages
/[Bb]uild/
/BuildV2/
/Build.zip
*.apk
*.aab
*.app
*.unitypackage
*.unitypackage.meta
crashlytics-build.properties

# TestRunner generated scenes
InitTestScene*.unity*

# Addressables build output
/ServerData/
/[Aa]ssets/[Ss]treamingAssets/aa*
/[Aa]ssets/[Aa]ddressableAssetsData/link.xml*
/[Aa]ssets/[Aa]ddressables_Temp*
/[Aa]ssets/[Aa]ddressable[Aa]ssets[Dd]ata/*/*.bin*

# Visual Scripting generated files
/[Aa]ssets/Unity.VisualScripting.Generated/VisualScripting.Flow/UnitOptions.db
/[Aa]ssets/Unity.VisualScripting.Generated/VisualScripting.Flow/UnitOptions.db.meta
/[Aa]ssets/Unity.VisualScripting.Generated/VisualScripting.Core/Property\ Providers
/[Aa]ssets/Unity.VisualScripting.Generated/VisualScripting.Core/Property\ Providers.meta

# Autogenerated JetBrains Rider plugin
/[Aa]ssets/Plugins/Editor/JetBrains*

# Auto-generated scenes and dependency caches
/[Aa]ssets/[Ii]nit[Tt]est[Ss]cene*.unity*
/[Aa]ssets/[Ss]ceneDependencyCache*

# ---- AI coding agents (Claude Code / Codex) ----
.claude/
.codex/
CLAUDE*.md
AGENTS*.md
.mcp.local.json

# ---- OS ----
.DS_Store
Thumbs.db

# Unity Test Framework 가 테스트 실행마다 생성한다. 빌드에 들어가면 안 된다.
/[Aa]ssets/[Rr]esources/PerformanceTestRun*.json*

# GitHub Pages에 배포하는 완성된 WebGL 플레이어는 추적한다.
!/WebGLBuild/Build/
!/WebGLBuild/Build/**
